{
  "archinstall-language": "English",
  "version": "4.4",
  "script": "guided",
  "silent": true,
  "hostname": "nidara",
  "kernels": ["linux"],
  "ntp": true,
  "timezone": "Europe/Madrid",
  "locale_config": { "kb_layout": "us", "sys_enc": "UTF-8", "sys_lang": "en_US" },
  "bootloader_config": { "bootloader": "Systemd-boot", "uki": false, "removable": false },
  "network_config": { "type": "nm" },
  "profile_config": { "profile": { "main": "Minimal" }, "gfx_driver": "All open-source" },
  "swap": { "enabled": true, "algorithm": "zstd" },
  "packages": [],
  "pacman_config": { "parallel_downloads": 5 },
  "mirror_config": {
    "mirror_regions": {},
    "custom_servers": [],
    "optional_repositories": [],
    "custom_repositories": [
      {
        "name": "nidara",
        "url": "https://nidara-project.github.io/nidara-repo/$arch",
        "sign_check": "Required",
        "sign_option": "TrustedOnly"
      }
    ]
  },
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/vda",
        "wipe": true,
        "partitions": [
          {
            "obj_id": "11111111-1111-1111-1111-111111111111",
            "status": "create",
            "type": "primary",
            "flags": ["boot", "esp"],
            "fs_type": "fat32",
            "mountpoint": "/boot",
            "mount_options": [],
            "btrfs": [],
            "start": { "unit": "MiB", "value": 1, "sector_size": null },
            "size":  { "unit": "MiB", "value": 512, "sector_size": null }
          },
          {
            "obj_id": "22222222-2222-2222-2222-222222222222",
            "status": "create",
            "type": "primary",
            "flags": [],
            "fs_type": "ext4",
            "mountpoint": "/",
            "mount_options": [],
            "btrfs": [],
            "start": { "unit": "MiB", "value": 513, "sector_size": null },
            "size":  { "unit": "Percent", "value": 100, "sector_size": null }
          }
        ]
      }
    ]
  },
  "custom_commands": [
    "set -e; echo '>> [nidara] trusting the repo signing key'; curl -fsSL https://nidara-project.github.io/nidara-repo/nidara.gpg | pacman-key --add -; pacman-key --lsign-key 80B0AC8C36A43611A8619959B06B716279F755A9",
    "set -e; echo '>> installing the desktop'; pacman -Sy --noconfirm nidara nidara-apps",
    "set -e; echo '>> nidara-setup'; SUDO_USER=nidara nidara-setup"
  ]
}
